{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm db:generate)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(pnpm lint)",
      "PowerShell(pnpm test)",
      "PowerShell(pnpm test:*)",
      "PowerShell(pnpm build)",
      "PowerShell(pnpm db:generate)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(pnpm drizzle-kit push *)",
      "Bash(npx drizzle-kit push *)",
      "Bash(drizzle-kit push *)",
      "PowerShell(git push *)",
      "PowerShell(pnpm drizzle-kit push *)",
      "PowerShell(npx drizzle-kit push *)",
      "PowerShell(drizzle-kit push *)"
    ]
  }
}
