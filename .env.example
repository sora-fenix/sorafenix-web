# =============================================================================
# SORA — environment variables
#
# Copy this file to `.env.local` and fill it in. Every variable below is
# declared and parsed in `lib/env.ts`. The app CRASHES AT BOOT if a required
# one is missing — that is deliberate (CLAUDE.md rule 1).
#
# Never commit `.env.local`. Never read process.env outside `lib/env.ts`.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE — required. The app will not start without these.
# -----------------------------------------------------------------------------

# Supabase project URL.
# Supabase dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"

# Supabase anon/publishable key. Safe to expose to the browser: it is subject
# to Row Level Security. This is the ONLY Supabase key that may reach a client.
# Supabase dashboard → Project Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Public base URL of this app. Used to build magic-link redirect targets, so it
# must match exactly what is registered under Supabase → Authentication → URL
# Configuration → Redirect URLs.
#   local:      http://localhost:3000
#   production: https://app.yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase service-role key. BYPASSES ROW LEVEL SECURITY.
# May only ever be read inside `lib/db/admin.ts` (CLAUDE.md rule 6).
# Supabase dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Postgres connection string for Drizzle migrations and server queries.
# Use the SESSION pooler string (port 5432) for `db:migrate`; the transaction
# pooler (port 6543) does not support the statements migrations need.
# Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.your-project-ref:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Shared secret for the n8n lead-ingestion webhook. n8n signs the raw request
# body with HMAC-SHA256 using this value; we verify before parsing.
# Minimum 32 characters. Generate with:  openssl rand -hex 32
N8N_WEBHOOK_SECRET="change-me-to-at-least-32-random-characters"


# =============================================================================
# INTEGRATIONS — optional today.
#
# These are declared in `lib/env.ts` as optional so the app boots before the
# modules that use them exist. Each one is promoted to REQUIRED in the phase
# that ships its module. Do not delete the block; fill it in when you get there.
# =============================================================================


# -----------------------------------------------------------------------------
# LLM — required by Module 3 (Qualification) and Module 5 (Content Generator)
# Primary model gemini-2.5-flash, fallback gpt-4.1-mini. Model IDs are pinned in
# `lib/ai/models.ts`; never hardcode a model string anywhere else.
# -----------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENAI_API_KEY=""


# -----------------------------------------------------------------------------
# Gmail API — required by Module 6 (email sending)
# One OAuth client, consented per workspace. Scopes: gmail.send, gmail.readonly.
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# -----------------------------------------------------------------------------
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"


# -----------------------------------------------------------------------------
# WhatsApp Cloud API — required by Module 7 (WhatsApp sending)
# Meta → WhatsApp → API Setup
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Echoed back during Meta's webhook verification handshake. Any random string.
WHATSAPP_VERIFY_TOKEN=""
# App secret, used to verify the x-hub-signature-256 header on inbound webhooks.
WHATSAPP_APP_SECRET=""


# -----------------------------------------------------------------------------
# Serper — optional. Search/Places enrichment fallback when n8n does not supply
# enough data. Module 2 (Enrichment).
# -----------------------------------------------------------------------------
SERPER_API_KEY=""
